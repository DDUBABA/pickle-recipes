{
  "name": "pickle-recipes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "validate": "node scripts/validate.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev": "node scripts/build.mjs && wrangler pages dev dist",
    "deploy": "node scripts/build.mjs && wrangler pages deploy dist --project-name pickle-recipes",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote"
  },
  "devDependencies": { "wrangler": "^4.0.0" }
}
