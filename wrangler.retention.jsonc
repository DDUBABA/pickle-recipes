{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pickle-recipes-retention",
  "main": "workers/retention-cron/index.js",
  "compatibility_date": "2026-11-17",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {"crons": ["0 19 * * *"]},
  "d1_databases": [{
    "binding": "DB",
    "database_name": "pickle-recipes",
    "database_id": "a86265e8-3489-46a5-996a-1f84f48ec7e5",
    "migrations_dir": "migrations"
  }],
  "observability": {"enabled": true}
}
